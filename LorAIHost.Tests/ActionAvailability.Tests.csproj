<Project Sdk="Microsoft.NET.Sdk">
  <!-- 离线单元测试：只链接零游戏依赖的纯逻辑文件，
       在任意平台的 dotnet 上可跑（不需要 Unity/游戏/网络） -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ActionAvailability.Tests</AssemblyName>
    <RootNamespace>LorAIHost.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../LorAIHost/ActionAvailability.cs" Link="ActionAvailability.cs" />
  </ItemGroup>
</Project>
